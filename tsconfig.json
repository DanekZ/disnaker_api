{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src",
    "test",
    "generated/prisma/client"
  ],
  "exclude": [
    "node_modules",
    "prisma/**/*"
  ]
}