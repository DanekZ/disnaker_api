// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------
// ENUMS
// --------------------
enum EmployeeStatus {
  baru @map("baru")
  PKWT_1 @map("PKWT_1")
  PKWT_2 @map("PKWT_2")
  permanent @map("permanent")
}

enum AdminRole {
  perusahaan @map("perusahaan")
  disnaker @map("disnaker")
}

enum ContractStatus {
  disetujui @map("disetujui")
  ditolak @map("ditolak")
}

// removed legacy UserRole enum; roles are managed via app_roles relation

enum AdminDivisions{
  SUPERADMIN @map("superadmin")
  ADMINLAYANAN @map("adminlayanan")
  ADMINPELATIHAN @map("adminpelatihan")
  ADMINPKWT @map("adminpkwt")
}

enum CompanyStatus {
 APPROVED @map("approved by disnaker")
  PENDING @map("pending")
  REJECTED @map("rejected")
}

model admins {
  username String @id @db.VarChar(255)
  password String @db.VarChar(255)
  role AdminRole
  id_perusahaan Int
  token String? @db.VarChar(255)

  @@map("admins")
}

// --------------------
// MODELS
// --------------------
model employees {
  id_karyawan   String          @id @default(uuid()) @db.VarChar(191)
  NIK           String          @unique @db.VarChar(191)
  kode_jabatan  Int
  kode_divisi   Int
  id_perusahaan String          @db.VarChar(255)
  nama          String          @db.VarChar(255)
  status        EmployeeStatus  @default(baru)

  // Relations
  company company_profile @relation(fields: [id_perusahaan], references: [id])
  position      positions       @relation(fields: [kode_jabatan], references: [id])
  division      divisions       @relation(fields: [kode_divisi], references: [id])
  contracts     contracts[]

  @@map("employees")
}

model positions {
  id       Int         @id @default(autoincrement())
  nama     String      @db.VarChar(255)
  company_id String @db.VarChar(255)

  company company_profile @relation(fields: [company_id], references: [id])
  employee employees[]

  @@map("positions")
}


// User Model
model users {
  id String @id @default(uuid()) @db.VarChar(255)
  username String @unique @db.VarChar(255)
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role_ref_id Int?

  disnaker_profile disnaker_profile?
  company_profile company_profile?
  candidate_profile candidate_profile?
  role_ref app_roles? @relation(fields: [role_ref_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model divisions {
  id       Int         @id @default(autoincrement())
  company_id String @db.VarChar(255)
  nama     String      @db.VarChar(255)
  employee employees[]

  company company_profile @relation(fields: [company_id], references: [id])

  @@map("divisions")
}

// COMPANY MODEL
model company_profile {
   id String @unique @default(uuid()) @db.VarChar(255)
  user_id String @unique @db.VarChar(255)
  company_name String @db.VarChar(255)
  company_logo String? @db.VarChar(255)
  no_handphone String @db.VarChar(20)
  province String @db.VarChar(255)
  city String @db.VarChar(255)
  address String @db.VarChar(255)
  website String? @db.VarChar(255)
  about_company String @db.VarChar(255)
  status CompanyStatus @default(PENDING)
  disnaker_id String? @db.VarChar(255)

  positions positions[]
  divisions divisions[]
  employees employees[]
  jobs jobs[]
  applications jobs_applications[]
  user users @relation(fields: [user_id], references: [id])
  disnaker disnaker_profile? @relation(fields: [disnaker_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  @@map("company_profiles")
}

model disnaker_profile {
  id String @unique @db.VarChar(255) @default(uuid())
  user_id String @unique @db.VarChar(255)
  divisi      AdminDivisions @default(ADMINLAYANAN)
  full_name   String          @db.VarChar(255)

  company_profile company_profile[]
  user users @relation(fields: [user_id], references: [id])
  contracts contracts[]
  ak1_cards candidate_ak1_cards[]
  jobs jobs[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("disnaker_profiles")
}

model contracts {
  id   String          @unique @db.VarChar(255) @default(uuid())
  id_karyawan  String          @db.VarChar(100)
  tgl_mulai    DateTime        @db.DateTime(3)
  masa_kontrak Int
  kontrak_file String          @db.VarChar(255)
  status       ContractStatus
  pesan        String          @db.VarChar(255)
  id_disnaker  String       @db.VarChar(255)

  employee     employees       @relation(fields: [id_karyawan], references: [id_karyawan])
  disnaker disnaker_profile @relation(fields: [id_disnaker], references: [id])

  @@map("contracts")
}

model candidate_profile {
  id String @id @default(uuid()) @db.VarChar(255) @map("candidate_id")
  user_id String @unique @db.VarChar(255)
  full_name String @db.VarChar(255)
  birthdate DateTime @db.Date
  place_of_birth String @db.VarChar(255)
  nik String @unique @db.VarChar(191)
  province String @db.VarChar(255)
  address String @db.VarChar(255)
  postal_code String @db.VarChar(20)
  gender String @db.VarChar(20)
  no_handphone String @db.VarChar(20)
  photo_profile String? @db.VarChar(255)
  last_education String @db.VarChar(255)
  graduation_year Int
  status_perkawinan String @db.VarChar(50)
  cv_file String? @db.VarChar(255)
  ak1_file String? @db.VarChar(255)

  user users @relation(fields: [user_id], references: [id])
  ak1_documents candidate_ak1_documents[]
  applications jobs_applications[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("candidate_profiles")
}

model candidate_ak1_documents {
  id String @id @default(uuid()) @db.VarChar(255) @map("ak1_document_id")
  candidate_id String @db.VarChar(255)
  ktp String @db.VarChar(255)
  ijazah String @db.VarChar(255)
  pas_photo String @db.VarChar(255)
  certificate String? @db.VarChar(255)

  candidate candidate_profile @relation(fields: [candidate_id], references: [id])
  ak1_card candidate_ak1_cards?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("candidate_ak1_documents")
}

enum CandidateAk1Status {
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum JobType {
  full_time @map("full-time")
  part_time @map("part-time")
  internship @map("internship")
  contract @map("contract")
  freelance @map("freelance")
}

enum JobStatus {
  pending @map("pending")
  approved @map("approved")
  rejected @map("rejected")
  closed @map("closed")
}

enum ApplicationStatus {
  pending @map("pending")
  test @map("test")
  interview @map("interview")
  approve @map("approve")
  rejected @map("rejected")
}

model candidate_ak1_cards {
  id String @id @default(uuid()) @db.VarChar(255) @map("ak1_card_id")
  ak1_document_id String @unique @db.VarChar(255)
  disnaker_id String @db.VarChar(255)
  status CandidateAk1Status
  file String @db.VarChar(255)
  note String? @db.VarChar(255)

  document candidate_ak1_documents @relation(fields: [ak1_document_id], references: [id])
  disnaker disnaker_profile @relation(fields: [disnaker_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("candidate_ak1_cards")
}

model app_roles {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  users users[]
  permissions role_permissions[]

  @@map("app_roles")
}

model app_permissions {
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(100)
  label String @db.VarChar(255)

  roles role_permissions[]

  @@map("app_permissions")
}

model role_permissions {
  role_id Int
  permission_id Int

  role app_roles @relation(fields: [role_id], references: [id])
  permission app_permissions @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model jobs {
  id String @id @default(uuid()) @db.VarChar(255) @map("jobs_id")
  company_id String @db.VarChar(255)
  job_title String @db.VarChar(255)
  job_type JobType
  job_description String @db.VarChar(2000)
  category String @db.VarChar(255)
  min_salary Int
  max_salary Int
  experience_required String @db.VarChar(255)
  education_required String @db.VarChar(255)
  skills_required String @db.VarChar(255)
  work_setup String @db.VarChar(255)
  application_deadline DateTime
  disnaker_id String? @db.VarChar(255)
  status JobStatus @default(pending)

  company company_profile @relation(fields: [company_id], references: [id])
  disnaker disnaker_profile? @relation(fields: [disnaker_id], references: [id])
  applications jobs_applications[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jobs")
}

model jobs_applications {
  id String @id @default(uuid()) @db.VarChar(255) @map("application_id")
  candidate_id String @db.VarChar(255)
  company_id String @db.VarChar(255)
  job_id String @db.VarChar(255)
  application_date DateTime @default(now())
  status ApplicationStatus @default(pending)
  schedule_start DateTime?
  schedule_end DateTime?
  note String? @db.VarChar(255)

  candidate candidate_profile @relation(fields: [candidate_id], references: [id])
  company company_profile @relation(fields: [company_id], references: [id])
  job jobs @relation(fields: [job_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jobs_applications")
}

