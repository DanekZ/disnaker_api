// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------
// ENUMS
// --------------------
enum EmployeeStatus {
  baru @map("baru")
  PKWT_1 @map("PKWT_1")
  PKWT_2 @map("PKWT_2")
  permanent @map("permanent")
}

enum AdminRole {
  perusahaan @map("perusahaan")
  disnaker @map("disnaker")
}

enum ContractStatus {
  disetujui @map("disetujui")
  ditolak @map("ditolak")
  pending @map("pending")
}

enum UserRole{
  CANDIDATE @map("candidate")
  COMPANY @map("company")
  DISNAKER @map("disnaker")
}

enum AdminDivisions{
  SUPERADMIN @map("superadmin")
  ADMINLAYANAN @map("adminlayanan")
  ADMINPELATIHAN @map("adminpelatihan")
  ADMINPKWT @map("adminpkwt")
}

enum CompanyStatus {
 APPROVED @map("approved by disnaker")
  PENDING @map("pending")
  REJECTED @map("rejected")
}

// --------------------
// MODELS
// --------------------
model employees {
  id_karyawan   String          @id @default(uuid()) @db.VarChar(191)
  NIK           String          @unique @db.VarChar(191)
  kode_jabatan  Int
  kode_divisi   Int
  id_perusahaan String          @db.VarChar(255)
  nama          String          @db.VarChar(255)
  status String? @db.VarChar(100)
  

  // Relations
  company company_profile @relation(fields: [id_perusahaan], references: [id], onDelete: Cascade)
  position      positions       @relation(fields: [kode_jabatan], references: [id], onDelete: Cascade)
  division      divisions       @relation(fields: [kode_divisi], references: [id], onDelete: Cascade)
  contracts     contracts[]

  @@map("employees")
}

model positions {
  id       Int         @id @default(autoincrement())
  nama     String      @db.VarChar(255)
  company_id String @db.VarChar(255)

  company company_profile @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee employees[]

  @@map("positions")
}


// User Model
model users {
  id String @id @default(uuid()) @db.VarChar(255)
  username String @unique @db.VarChar(255)
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role UserRole @default(CANDIDATE)

  disnaker_profile disnaker_profile?
  company_profile company_profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model divisions {
  id       Int         @id @default(autoincrement())
  company_id String @db.VarChar(255)
  nama     String      @db.VarChar(255)
  employee employees[]

  company company_profile @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("divisions")
}

// COMPANY MODEL
model company_profile {
   id String @id @default(uuid()) @db.VarChar(255)
  user_id String @unique @db.VarChar(255)
  company_name String @db.VarChar(255)
  company_logo String? @db.VarChar(255)
  no_handphone String @db.VarChar(20)
  province String @db.VarChar(255)
  city String @db.VarChar(255)
  address String @db.VarChar(255)
  website String? @db.VarChar(255)
  about_company String @db.VarChar(255)
  status CompanyStatus @default(PENDING)
  disnaker_id String? @db.VarChar(255)

  positions positions[]
  divisions divisions[]
  employees employees[]
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  disnaker disnaker_profile? @relation(fields: [disnaker_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@map("company_profile")
}

model disnaker_profile {
  id String @id @default(uuid()) @db.VarChar(255)
  user_id String @unique @db.VarChar(255)
  divisi      AdminDivisions @default(ADMINLAYANAN)
  full_name   String          @db.VarChar(255)

  company_profile company_profile[]
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contracts contracts[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("disnaker_profiles")
}

model contracts {
  id   String          @id @db.VarChar(255) @default(uuid())
  id_karyawan  String          @db.VarChar(100)
  tgl_mulai    DateTime        @db.DateTime()
  tgl_selesai DateTime?        @db.DateTime()
  masa_kontrak Int
  kontrak_file String?          @db.VarChar(255)
  status_persetujuan       ContractStatus @default(pending)
  pesan        String?          @db.VarChar(255)
  id_disnaker  String?       @db.VarChar(255)
  // status_kontrak        EmployeeStatus  @default(baru)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  employee     employees       @relation(fields: [id_karyawan], references: [id_karyawan], onDelete: Cascade)
  disnaker disnaker_profile? @relation(fields: [id_disnaker], references: [id], onDelete: SetNull)

  @@map("contracts")
}

